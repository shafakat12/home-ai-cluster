# Home AI Cluster - settings
# Copy this file to config.env and change what you need. Anything left empty is detected automatically.
#   cp config.example.env config.env && nano config.env

# --- Network --------------------------------------------------------------------------------
# IP address of this server. Empty = detected (the address of the default network interface).
# TIP: reserve this address in your router (DHCP reservation / static lease) so it never changes.
SERVER_IP=

# Your home network in CIDR form. Empty = detected (e.g. 192.168.1.0/24).
LAN_CIDR=

# Optional: the IP of your main PC. It may use the AI API directly (VS Code, Claude Code, scripts)
# and can create the control-panel admin password without the setup code.
# More devices can be allowed later in the control panel (Settings).
ADMIN_PC_IP=

# --- Models ---------------------------------------------------------------------------------
# Which starter models to download:
#   auto     = choose from the server's GPU memory (recommended)
#   small    = Qwen3.5 4B only                                   (~3 GB download, any GPU with 4 GB+)
#   standard = Qwen3.5 4B + gpt-oss 20B (pooled over all GPUs)   (~16 GB download)
#   full     = standard + Gemma 4 12B (vision) on the GPU PCs    (~24 GB download, needs a 2nd GPU PC)
#   none     = download nothing now (add models later in the control panel)
MODEL_PRESET=auto

# --- Storage: where the models (and backups) are kept ------------------------------------
# Models are big (3-30 GB each). Leave STORAGE empty and the installer ASKS you (it lists your drives).
# Or set it here (useful for unattended installs). You can change it any time later:  sudo ai-storage
#   STORAGE=                                  ask during install (or keep /opt/ai/models if there is no other drive)
#   STORAGE=folder:/mnt/data/ai-models        a folder on a drive that is already set up - erases nothing
#   STORAGE=drive:/dev/sdb                    ERASE this drive, format it (ext4) and use it
#   STORAGE=raid1:/dev/sdb,/dev/sdc           ERASE these drives and combine them into a RAID:
#                                             raid0 (2+ drives, fastest, NO safety), raid1 (2+, mirror),
#                                             raid5 (3+, survives 1 dead drive), raid10 (4+, fast + safe)
# Tip: /dev/disk/by-id/... names never change, /dev/sdX names can. See docs/storage.md
STORAGE=
# Erasing needs you to type ERASE in the terminal. Set yes only for unattended installs.
STORAGE_ERASE_OK=no
# Also keep the nightly backups on the new drive/RAID: auto (= ask; yes for a drive/RAID 1/5/10), yes, no
STORAGE_BACKUPS=auto

# --- Features -------------------------------------------------------------------------------
INSTALL_OPEN_WEBUI=yes       # chat website for everyone (port 3000)
INSTALL_WEB_SEARCH=yes       # private web search (SearXNG) for the chat
INSTALL_CONTROL_PANEL=yes    # admin web page (port 8091): models, GPUs, health, settings
INSTALL_HEALTH=yes           # disk SMART health, service checks, nightly backups

# Nightly backups are kept 7 days in /opt/ai/backups, or on the storage drive (see STORAGE above).
# To use another folder:  sudo ai-storage backups /path/to/folder

# Install the NVIDIA driver automatically if an NVIDIA GPU is found without a driver (needs one reboot).
INSTALL_NVIDIA_DRIVER=yes
